{
  "info": {
    "name": "Biblioteca do Campus - API REST",
    "description": "Execute em ordem pelo Collection Runner, com a aplicação recém-iniciada e a carga inicial habilitada. A coleção altera dados e devolve o empréstimo inicial. Reinicie a aplicação antes de executar novamente. Inclui os 15 endpoints e respostas 200, 201, 204, 400, 404 e 409.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "livroId",
      "value": ""
    },
    {
      "key": "leitorId",
      "value": ""
    },
    {
      "key": "emprestimoId",
      "value": ""
    },
    {
      "key": "isbnTeste",
      "value": ""
    },
    {
      "key": "emailTeste",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === \"01 - Listar livros iniciais\") {",
          "  const agora = Date.now().toString();",
          "  pm.collectionVariables.set(\"isbnTeste\", agora.slice(-13).padStart(13, \"0\"));",
          "  pm.collectionVariables.set(\"emailTeste\", \"teste.\" + agora + \"@campus.edu.br\");",
          "}"
        ]
      }
    }
  ],
  "item": [
