    {
      "name": "10 - Erro 400: livro inválido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/livros",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"\",\n  \"autor\": \"\",\n  \"isbn\": \"abc\",\n  \"anoPublicacao\": 1400,\n  \"quantidadeTotal\": 0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Formato ProblemDetail\", () => { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"); pm.expect(pm.response.json().status).to.eql(pm.response.code); });",
              "pm.test(\"Mapa de erros\", () => { pm.expect(pm.response.json().errors).to.have.property(\"isbn\"); pm.expect(pm.response.json().errors).to.have.property(\"quantidadeTotal\"); });"
            ]
          }
        }
      ]
